# Copy to .env. Optional: the stack runs without LLM keys using fixture scenarios.

DATABASE_URL=postgresql+psycopg://bay:bay@postgres:5432/bayworks

S3_ENDPOINT=http://localstack:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=bayworks
S3_REGION=us-east-1

MOCK_DMS_URL=http://mock-dms:8001

# Groq has a free Whisper + Llama tier. OpenAI also works.
GROQ_API_KEY=
OPENAI_API_KEY=

# extract | groq | openai | heuristic
LLM_PROVIDER=auto
STT_PROVIDER=auto
